# Copy this file to .env for local overrides. Do not commit .env.
ARION_ENVIRONMENT=development
ARION_LOG_LEVEL=INFO

# Replace these development-only placeholders in every deployed .env file.
POSTGRES_DB=arion
POSTGRES_USER=arion
POSTGRES_PASSWORD=replace-me
ARION_DATABASE_URL=postgresql+psycopg://arion:replace-me@db:5432/arion

ARION_MEDIA_ROOT=/var/lib/arion/media
ARION_MAX_UPLOAD_BYTES=524288000
ARION_FFPROBE_EXECUTABLE=ffprobe
ARION_FFPROBE_TIMEOUT_SECONDS=30
ARION_RECONCILIATION_GRACE_SECONDS=3600

# Exact browser origins allowed to call the API, separated by commas.
# Leave empty for the secure default (no cross-origin browser access).
ARION_CORS_ORIGINS=

# Compose publishes the API only on loopback by default.
# On the private server, set this to the server's LAN IP when LAN access is needed.
ARION_BIND_ADDRESS=127.0.0.1
ARION_PORT=8000
