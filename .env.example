# Copy this file to .env for local overrides. Do not commit .env.
ARION_ENVIRONMENT=development
ARION_LOG_LEVEL=INFO

# Replace these development-only placeholders in every deployed .env file.
POSTGRES_DB=arion
POSTGRES_USER=arion
POSTGRES_PASSWORD=replace-me
ARION_DATABASE_URL=postgresql+psycopg://arion:replace-me@db:5432/arion

ARION_MEDIA_ROOT=/var/lib/arion/media
ARION_MAX_UPLOAD_BYTES=524288000
ARION_FFPROBE_EXECUTABLE=ffprobe
ARION_FFMPEG_EXECUTABLE=ffmpeg
ARION_FFPROBE_TIMEOUT_SECONDS=30
ARION_RECONCILIATION_GRACE_SECONDS=3600

# Exact browser origins allowed to call the API, separated by commas.
# Leave empty for the secure default (no cross-origin browser access).
ARION_CORS_ORIGINS=

# Experimental YouTube acquisition is opt-in. Replace the secret with at least
# 32 random bytes before setting the enabled flag to true.
ARION_YOUTUBE_ACQUISITION_ENABLED=false
ARION_YOUTUBE_CANDIDATE_SECRET=replace-me
ARION_YOUTUBE_CANDIDATE_TTL_SECONDS=600
ARION_YOUTUBE_CANDIDATE_LIMIT=5
ARION_YOUTUBE_DISCOVERY_TIMEOUT_SECONDS=20
ARION_YOUTUBE_MAX_DURATION_SECONDS=900
ARION_YOUTUBE_MAX_OUTPUT_BYTES=104857600
ARION_YOUTUBE_MIN_FREE_BYTES=1073741824
ARION_YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=600
ARION_YOUTUBE_PROCESSING_TIMEOUT_SECONDS=180
ARION_YOUTUBE_JOB_MAX_ATTEMPTS=2
ARION_YOUTUBE_JOB_LEASE_SECONDS=120
ARION_YOUTUBE_JOB_RETENTION_SECONDS=604800
ARION_YOUTUBE_WORKER_POLL_SECONDS=2
ARION_YTDLP_EXECUTABLE=yt-dlp

# Compose publishes the API only on loopback by default.
# Keep this on loopback when clients use the web gateway.
ARION_BIND_ADDRESS=127.0.0.1
ARION_PORT=8000

# Compose also publishes the web client/API gateway only on loopback by default.
# On the private server, set ARION_WEB_BIND_ADDRESS to the fixed LAN IP.
ARION_WEB_BIND_ADDRESS=127.0.0.1
ARION_WEB_PORT=8080

# Image names can be overridden for isolated verification or versioned deployment.
ARION_API_IMAGE=arion-api:local
ARION_WEB_IMAGE=arion-web:local
